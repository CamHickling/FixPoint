# Recordings are large and contain participant data: keep them out of git...
*.mp4
*.mov
*.avi
*.mkv
*.wmv
*.flv
*.webm
*.m4v
*.mpeg
*.mpg
*.csv
*.xlsx

# ...except the anonymised example recording that ships with the tool.
!examples/**/*.csv
!examples/**/*.mp4

# Generated by the tool
output/

# Python
__pycache__/
*.egg-info/
.pytest_cache/
